<?xml version="1.0" encoding="utf-8"?>
<!-- Restore from nuget.org only, ignoring whatever sources or fallback folders
     the machine has configured, so a local restore matches CI. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
