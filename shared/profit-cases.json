    {
      "name": "a schedule without shipping charges on price alone",
      "feeOverrides": {
        "ebay": {
          "percent": 10,
          "fixed": 0,
          "includesShipping": false
        }
      },
      "sale": {
        "platform": "ebay",
        "price": 40,
        "shippingCharged": 5
      },
      "expected": 4
    }
