      "expected": 0.93
    },
    {
      "name": "just under halfway rounds down: Depop $12.35 is 0.40755 + 0.45",
      "sale": {
        "platform": "depop",
        "price": 12.35,
        "shippingCharged": 0
      },
      "expected": 0.86
    },
    {
      "name": "halfway where the original app got it a cent low (float): eBay $150 is 19.875 + 0.40, rounds up to 20.28",
      "sale": {
        "platform": "ebay",
        "price": 150,
        "shippingCharged": 0
      },
      "expected": 20.28
