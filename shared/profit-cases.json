{
  "$comment": "Profit-math cases shared by the C# domain tests and the client Vitest suite. Money is in dollars with at most 2 decimals; fee schedules not overridden come from platforms.json. margin and roi are ratios, compared to within 1e-9. Generated once from an exact integer-cents oracle and cross-checked against the original app; edit by hand from here on.",
  "estimateFees": [
    {
      "name": "eBay charges on price plus shipping",
      "sale": {
        "platform": "ebay",
        "price": 40,
        "shippingCharged": 5
      },
      "expected": 6.36
    },
    {
      "name": "Depop charges payment processing on the whole order",
      "sale": {
        "platform": "depop",
        "price": 30,
        "shippingCharged": 4
      },
      "expected": 1.57
    },
    {
      "name": "Vinted charges nothing",
      "sale": {
        "platform": "vinted",
        "price": 30,
        "shippingCharged": 4
      },
      "expected": 0
    },
    {
      "name": "an empty sale costs nothing, not a bare fixed fee",
      "sale": {
        "platform": "ebay",
        "price": 0,
        "shippingCharged": 0
      },
      "expected": 0
    },
    {
      "name": "an unknown platform falls back to the \"other\" schedule",
      "sale": {
        "platform": "grailed",
        "price": 50,
        "shippingCharged": 0
      },
      "expected": 0
    },
    {
      "name": "halfway: eBay $10 is 1.325 + 0.40, rounds up to 1.73",
