      "name": "halfway where the original app got it a cent low (float): Depop $485 is 16.005 + 0.45, rounds up to 16.46",
      "sale": {
        "platform": "depop",
        "price": 485,
        "shippingCharged": 0
      },
      "expected": 16.46
